{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ejecutar Servidor Node.js",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "NODE_ENV": "development"
            }
        },
        {
            "name": "Depurar en Navegador",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/public",
            "preLaunchTask": "npm: start",
            "serverReadyAction": {
                "pattern": "Servidor ejecutándose en puerto 3000",
                "uriFormat": "http://localhost:3000",
                "action": "debugWithEdge"
            }
        },
        {
            "name": "Adjuntar a Navegador",
            "type": "msedge",
            "request": "attach",
            "port": 3000,
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/public"
        }
    ]
}